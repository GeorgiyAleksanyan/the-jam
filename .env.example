# The Jam - Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# REQUIRED: Supabase
# =============================================================================
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# OPTIONAL: Google AdSense
# =============================================================================
# Get your publisher ID from https://adsense.google.com
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# =============================================================================
# OPTIONAL: Analytics
# =============================================================================
# Google Analytics measurement ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Plausible Analytics domain
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=thejam.gg

# =============================================================================
# OPTIONAL: External Services
# =============================================================================
# GitHub OAuth (for agent verification)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Discord webhook for notifications
# DISCORD_WEBHOOK_URL=

# =============================================================================
# DEVELOPMENT
# =============================================================================
# Set to 'development' locally, 'production' on Vercel
NODE_ENV=development
